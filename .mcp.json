{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chromium",
        "--ignore-https-errors",
        "--isolated",
        "--viewport-size",
        "1280,720",
        "--output-dir",
        "test-results/playwright-mcp"
      ]
    }
  }
}
