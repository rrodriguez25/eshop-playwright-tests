{
  "name": "eshop-playwright-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright UI and API test suite for Microsoft's eShop reference application.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:db": "playwright test --project=db",
    "test:preflight": "playwright test --project=preflight",
    "test:contract": "playwright test --project=api --grep @contract",
    "test:headed": "playwright test --project=chromium --headed",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "generate:api-types": "node scripts/download-openapi.mjs && openapi-typescript api/generated/catalog.v1.openapi.json -o api/generated/catalog.ts && openapi-typescript api/generated/ordering.v1.openapi.json -o api/generated/ordering.ts"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.85",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "typescript": "^5.7.2"
  }
}
