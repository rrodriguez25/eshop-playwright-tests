BASE_URL=https://localhost:7298
API_URL=http://localhost:5222
API_CATALOG_URL=http://localhost:5222
API_ORDERING_URL=http://localhost:5224

# PostgreSQL started by eShop's AppHost. The port and password are generated per container:
#   docker port <postgres container> 5432
#   docker exec <postgres container> printenv POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=
DB_USER=postgres
DB_PASSWORD=

# Shared password of the static users in data/users.json. eShop seeds alice and bob with the
# password set in its src/Identity.API/UsersSeed.cs.
USER_PASSWORD=
